# Folder that holds the MMEX database, and the database's file name in it.
MMEX_DIR=/path/to/mmex
MMEX_DB_FILE=money.mmb

# mmex_web's own data (login secrets, and the history of its writes for
# undo). Keep it out of any synced folder.
APP_DATA_DIR=/path/to/mmex_web_data

# Backups of the DB, taken before a write when the newest is older than
# MMEX_BACKUP_MIN_INTERVAL_MIN minutes (0 = before every write). The newest
# MMEX_BACKUP_KEEP are kept.
BACKUP_DIR=/path/to/mmex_backups
MMEX_BACKUP_KEEP=20
MMEX_BACKUP_MIN_INTERVAL_MIN=30

# User and group that own MMEX_DIR.
PUID=1000
PGID=1000
TZ=UTC

# Host port, bound to 127.0.0.1 for the reverse proxy.
PORT=8000

# Reverse proxies in front that set X-Forwarded-For/-Proto (0 = none).
MMEX_WEB_TRUSTED_PROXIES=1
# 1 = session cookie over HTTPS only. Set 0 only for plain-HTTP testing.
MMEX_WEB_COOKIE_SECURE=1
# Serve under a path, e.g. /money, when the proxy forwards the full path.
MMEX_WEB_URL_PREFIX=
# How long a login lasts, in days.
MMEX_WEB_SESSION_DAYS=30
